    "start": {
      "year": 629
    },
    "end": {
      "year": 645
    },
    "precision": "year",
    "uncertainty": {
      "end_plus_years": 1,
      "note": "Pages agree on 629 and 645 but differ on intermediate dates: one timeline gives Bamiyan 632 and Nalanda 637; Encyclopedia.com says he arrived in India in 633 and studied five years at Nalanda. Intermediate waypoint years follow the Lifelong Learning Collaborative timeline only."
    },
