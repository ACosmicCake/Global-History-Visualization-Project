  "film": {
    "title": "A billion years of Earth",
    "blurb": "The continents move, ice spreads, life appears. A two-minute film drawn from the records.",
    "beats": [
      { "record": "-1000my-assembly-of-rodinia", "action": "layer.plates.scrub { from_ma: 1000, to_ma: 800, at: [45.6, -74.6], alt: 2.0 }", "caption": "A billion years ago, mountain building has just joined several continents into the supercontinent Rodinia." },
      { "record": "-717my-sturtian-snowball-earth", "action": "layer.plates.scrub { from_ma: 728, to_ma: 660, at: [64.6, -138.2], alt: 2.0 }", "caption": "About 717 million years ago the Sturtian glaciation begins, one of the ice ages called Snowball Earth." },
      { "record": "-635my-marinoan-snowball-earth", "action": "layer.plates.scrub { from_ma: 652, to_ma: 625, at: [-39.9, 144], alt: 2.0 }", "caption": "A second glaciation, the Marinoan, ends about 635 million years ago." },
      { "record": "-575my-ediacaran-biota", "action": "layer.plates.scrub { from_ma: 590, to_ma: 541, at: [46.6, -53.2], alt: 1.8 }", "caption": "From about 571 million years ago, large soft-bodied Ediacaran organisms spread through the oceans." },
      { "record": "-538my-cambrian-explosion", "action": "layer.plates.scrub { from_ma: 540, to_ma: 505, at: [24.7, 103], alt: 1.8 }", "caption": "From about 539 million years ago, almost every major animal body plan appears in the fossil record within some 20 to 30 million years." },
      { "record": "-470my-origin-of-land-plants", "action": "layer.plates.scrub { from_ma: 485, to_ma: 455, at: [-18.2, 124.3], alt: 1.8 }", "caption": "Microscopic spores about 480 million years old are the oldest evidence of plants on land." },
      { "record": "-445my-late-ordovician-mass-extinction", "action": "layer.plates.scrub { from_ma: 450, to_ma: 440, at: [55.4, -3.3], alt: 2.0 }", "caption": "About 445 million years ago comes a mass extinction: one study of brachiopods counts 69% of genera lost." },
      { "record": "-372my-late-devonian-extinction", "action": "scene.dim { ma: 372, at: [51.1, 9.1] }", "caption": "About 372 million years ago, oceanic anoxia accompanies massive losses of marine life." },
      { "record": "-335my-assembly-of-pangaea", "action": "layer.plates.scrub { from_ma: 345, to_ma: 270, at: [38, -79], alt: 2.0 }", "caption": "Gondwana and Laurussia converge as the Rheic Ocean closes, joining the continents into the supercontinent Pangaea." },
      { "record": "-252my-permian-triassic-extinction", "action": "scene.eruption { ma: 252, at: [69.35, 88.2], km: 690 }", "caption": "About 251.9 million years ago, most marine species die within roughly 60,000 years: Earth's most severe known mass extinction, most likely set off by Siberian Traps magmatism." },
      { "record": "-200my-breakup-of-pangaea", "action": "layer.plates.scrub { from_ma: 201, to_ma: 100, at: [21, -30], alt: 2.0 }", "caption": "From about 201 million years ago Pangaea comes apart: the Central Atlantic opens, Laurasia and Gondwana separate, and the South Atlantic unzips." },
      { "record": "-66my-chicxulub-impact", "action": "scene.impact { ma: 66.04, at: [21.29, -89.53], km: 180, alt: 1 }", "caption": "About 66.04 million years ago an asteroid roughly 10 km wide strikes the shallow sea off Yucatán, triggering the mass extinction that ends the age of the dinosaurs." },
      { "record": "-50my-india-asia-collision", "action": "layer.plates.scrub { from_ma: 65, to_ma: 38, at: [20, 78], alt: 1.6 }", "caption": "India, moving north, collides with Asia, raising the Himalaya and the Tibetan Plateau. The date is disputed: about 59 to 40 million years ago." },
      { "record": "-34my-eocene-oligocene-glaciation", "action": "layer.plates.scrub { from_ma: 38, to_ma: 28, at: [-69, 75], alt: 1.8 }", "caption": "Around 34 million years ago Earth shifts from a largely ice-free greenhouse to an icehouse, with the first major glaciation of Antarctica." },
      { "record": "-3my-closure-of-isthmus-of-panama", "action": "layer.plates.scrub { from_ma: 28, to_ma: 3, at: [9, -80], alt: 1.6 }", "caption": "Between three and 2.8 million years ago the Isthmus of Panama rises, severing the seaway between the Atlantic and Pacific." },
      { "record": "-300ka-rise-of-homo-sapiens", "action": "scene.arrive { year: -300000, at: [31.87, -8.87], alt: 1.6 }", "caption": "Around 300,000 years ago our species, Homo sapiens, is taking shape in Africa." },
      { "record": "-26ka-last-glacial-maximum", "action": "layer.plates.scrub { from_ma: 0.04, to_ma: 0.008, at: [62, -40], alt: 2.3 }", "caption": "The Last Glacial Maximum, about 26,500 to 19,000 years ago, marks the peak extent of the continental ice sheets, lowering global sea level by approximately 130 metres. Then the ice melts back." }
    ]
